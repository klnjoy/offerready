<mxfile host="app.diagrams.net" type="device">
  <diagram name="MCP Architecture" id="mcp-arch">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OfferReady — MCP: host / client / server" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="host" value="Host&#10;(IDE / chat app / agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="model" value="Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="client" value="MCP client&#10;(one per server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="MCP server: files&#10;tools · resources · prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="MCP server: database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="MCP server: SaaS API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="Trust boundary — allowlist servers · pin/review tool schemas ·&#10;least-privilege short-lived creds · treat output as DATA not instructions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m1" style="endArrow=none;html=1;" edge="1" parent="1" source="model" target="client"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1" value="tools/list · tools/call (JSON-RPC)" style="endArrow=block;startArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="client" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" source="client" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" source="client" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
