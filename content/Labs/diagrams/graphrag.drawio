        <mxCell id="sup" value="Supplier&#10;(flagged)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="590" y="370" width="80" height="50" as="geometry" />
