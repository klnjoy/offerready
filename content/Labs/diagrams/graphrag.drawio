        <mxCell id="graph" value="Knowledge graph" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="290" width="360" height="150" as="geometry" />
