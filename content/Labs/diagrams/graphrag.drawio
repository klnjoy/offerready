        <mxCell id="g1" value="PLACED" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="cust" target="ord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" value="…SUPPLIED_BY" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="ord" target="sup"><mxGeometry relative="1" as="geometry" /></mxCell>
