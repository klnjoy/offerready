# OfferReady — environment variables (EXAMPLE / PLACEHOLDERS ONLY)
# =============================================================================
# Copy to `.env` (gitignored) and fill with your own values. NEVER commit real
# secrets. Spec §15: secret/service-role keys stay SERVER-SIDE only; the browser
# may use ONLY the Supabase publishable (anon) key.
#
# Which keys are safe in the browser?
#   BROWSER-SAFE  -> SUPABASE_URL, SUPABASE_ANON_KEY (publishable), STRIPE_PUBLISHABLE_KEY
#   SERVER-ONLY   -> SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
#                    STRIPE_WEBHOOK_SECRET, OPENAI_API_KEY
# The server-only keys must be set as Vercel Environment Variables, never placed
# in content/assets/* or any file shipped to GitHub Pages.
# =============================================================================

# ---- Supabase --------------------------------------------------------------
# Project URL, e.g. https://YOUR-PROJECT-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable/anon key (BROWSER-SAFE — protected by RLS). Frontend + backend.
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Service-role key (SERVER-ONLY — bypasses RLS). Backend functions only.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret used to verify Supabase access tokens server-side (optional if the
# backend verifies via the Supabase auth endpoint instead). SERVER-ONLY.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---- Stripe (TEST MODE FIRST — spec §16/§31) -------------------------------
# Use test keys (sk_test_..., pk_test_...) until the full flow is verified.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key            # SERVER-ONLY
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key  # browser-safe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret     # SERVER-ONLY

# Price for the Pro subscription (configurable — do NOT hardcode in code).
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_price_id

# ---- Subscription access policy (spec §19) ---------------------------------
# When a subscription is canceled but paid through the period end, keep access
# until current_period_end (true) or revoke immediately (false).
ACCESS_UNTIL_PERIOD_END=true

# ---- OpenAI (existing features: analyze-job, ask) --------------------------
OPENAI_API_KEY=sk-your-openai-key                           # SERVER-ONLY
OPENAI_MODEL=gpt-4o-mini

# ---- CORS ------------------------------------------------------------------
# Exact site origin allowed to call the backend (no trailing slash).
ALLOWED_ORIGIN=https://klnjoy.github.io
