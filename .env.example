# OfferReady API — environment variables (Vercel project settings).
# Copy to .env for LOCAL dev only. NEVER commit a real .env (it is gitignored).

# Required: your OpenAI API key (server-side only; never exposed to the browser).
OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI model to use. Defaults to a cost-effective model in code
# (gpt-4o-mini) if unset. Change here to upgrade without touching app code.
OPENAI_MODEL=gpt-4o-mini

# Optional: the browser origin allowed to call the API (CORS). Defaults to the
# GitHub Pages site. Set to your Pages origin (no trailing path).
ALLOWED_ORIGIN=https://klnjoy.github.io
