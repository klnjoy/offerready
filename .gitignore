# ---- Build output (regenerated by mkdocs; never commit) ----
site/

# ---- Generated docs/ (regenerated from content/ by sync_docs.py) ----
# docs/ is a BUILD ARTIFACT: sync_docs.py regenerates it from content/ in CI.
# The whole tree is ignored — nothing under docs/ should be committed.
#
# NOTE: docs/Course-Modules/ was previously force-tracked to publish course
# module pages. That material is a third-party PAID course (personal-use only)
# and must NOT be redistributed, so it is fully ignored now and removed from the
# repo. Do not re-add an exception for it.
docs/

# ---- Agent index (regenerated by ask.py --reindex) ----
agent/kb_index.json

# ---- Python caches / envs ----
__pycache__/
*.pyc
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/

# ---- Logs & scratch ----
*.log
*.tmp

# ---- Secrets / credentials (must NEVER be committed) ----
*.pem
*.key
*.pfx
*.p12
*.env
.env
credentials
aws-credentials*
*.crt

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Node / Vercel backend (api/) ----
node_modules/
.vercel/
