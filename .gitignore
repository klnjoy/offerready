# ---- Build output (regenerated by mkdocs; never commit) ----
site/

# ---- Generated docs/ (regenerated from content/ by sync_docs.py) ----
# docs/ is a BUILD ARTIFACT: sync_docs.py regenerates it from content/ in CI.
# We ignore all of docs/ EXCEPT docs/Course-Modules/, which holds the course
# module pages + files that must be committed so CI can publish them (the
# external module source isn't available in CI).
docs/*
!docs/Course-Modules/

# ---- Agent index (regenerated by ask.py --reindex) ----
agent/kb_index.json

# ---- Python caches / envs ----
__pycache__/
*.pyc
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/

# ---- Logs & scratch ----
*.log
*.tmp

# ---- Secrets / credentials (must NEVER be committed) ----
*.pem
*.key
*.pfx
*.p12
*.env
.env
credentials
aws-credentials*
*.crt

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Node / Vercel backend (api/) ----
node_modules/
.vercel/
